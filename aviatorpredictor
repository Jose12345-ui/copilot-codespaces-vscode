// Define the round history
const roundHistory = [
    1.70, 1.66, 7.34, 1.11, 1.12, 1.16, 1.89, 1.14, 
    1.68, 2.51, 1.80, 1.27, 1.33, 5.11, 1.33, 3.30, 
    1.33, 1.71, 1.80, 1.00, 1.12, 2.87, 1.31, 1.05, 
    1.34, 2.08, 1.51, 1.04
];

// Function to calculate the average multiplier
function calculateAverage(history) {
    const sum = history.reduce((accumulator, currentValue) => accumulator + currentValue, 0);
    return sum / history.length;
}

// Function to predict the next multiplier (basic prediction using average)
function predictNextMultiplier(history) {
    return calculateAverage(history);
}

// Calculate average
const averageMultiplier = calculateAverage(roundHistory);

// Make a prediction
const predictedMultiplier = predictNextMultiplier(roundHistory);

// Output results
console.log("Round History:", roundHistory);
console.log("Average Multiplier:", averageMultiplier.toFixed(2));
console.log("Predicted Next Multiplier:", predictedMultiplier.toFixed(2));
